<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Xindex — The Future of Cross-Chain Indexes</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<style>
  :root {
    --bg:#03040a; --txt:#f0f2fb; --mut:#6e7999; --mut2:#454d6b;
    --acc:#7c83ff; --accent2:#22d3ee; --vio:#a855f7; --ok:#10b981; --warn:#f59e0b; --err:#ef4444;
    --grad:linear-gradient(135deg,#7c83ff 0%,#22d3ee 50%,#a855f7 100%);
    --glass:rgba(255,255,255,.03); --line:rgba(255,255,255,.07);
    --r:24px;
  }

  * { box-sizing:border-box; margin:0; padding:0; }
  html { scroll-behavior:smooth; overflow-x:hidden; scrollbar-width:thin; }
  body { font-family:'Inter',system-ui,sans-serif; background:var(--bg); color:var(--txt);
    -webkit-font-smoothing:antialiased; line-height:1.6; cursor:none; }

  /* === CUSTOM CURSOR === */
  .cursor-ring { position:fixed;width:40px;height:40px;border:1.5px solid rgba(124,131,255,.5);border-radius:50%;pointer-events:none;z-index:9999;transition:width .2s,height .2s,border-color .2s;transform:translate(-50%,-50%);mix-blend-mode:difference;}
  .cursor-dot { position:fixed;width:8px;height:8px;background:#7c83ff;border-radius:50%;pointer-events:none;z-index:9999;transform:translate(-50%,-50%);}
  .cursor-ring.hover { width:64px;height:64px;border-color:rgba(34,211,238,.7); }

  /* === WEBGL CANVAS BG === */
  #bgCanvas { position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.5; }

  /* === NOISE OVERLAY === */
  .noise { position:fixed;inset:0;z-index:1;pointer-events:none;opacity:.028;mix-blend-mode:overlay;background-repeat:repeat;
    background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 512 512' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.75' numOctaves='6' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); }

  /* === LAYOUT === */
  .wrap { max-width:1280px;margin:0 auto;padding:0 40px;position:relative;z-index:2; }

  /* === NAVBAR === */
  .navbar { position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:100;display:flex;align-items:center;gap:8px;
    padding:10px 16px;background:rgba(10,14,30,.7);backdrop-filter:blur(20px) saturate(1.5);-webkit-backdrop-filter:blur(20px) saturate(1.5);
    border:1px solid var(--line);border-radius:999px;transition:background .3s,border-color .3s,box-shadow .3s; }
  .navbar.scrolled { background:rgba(10,14,30,.88);border-color:rgba(124,131,255,.2);box-shadow:0 8px 40px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.05); }
  .nav-logo { width:36px;height:36px;border-radius:12px;background:var(--grad);display:grid;place-items:center;font-weight:900;color:#040810;font-size:18px;box-shadow:0 4px 20px rgba(124,131,255,.5);position:relative;overflow:hidden; }
  .nav-logo::after { content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(255,255,255,.5) 50%,transparent 60%);transform:translateX(-120%);animation:logoSheen 3.5s ease-in-out infinite; }
  @keyframes logoSheen { 0%,50%{transform:translateX(-120%)}70%,100%{transform:translateX(120%)} }
  .nav-links { display:flex;gap:4px;padding:0 6px; }
  .nav-links a { font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--mut);padding:7px 14px;border-radius:999px;transition:color .2s,background .2s; }
  .nav-links a:hover { color:var(--txt);background:rgba(255,255,255,.06); }
  .nav-btn { font-family:'JetBrains Mono',monospace;font-size:12px;padding:8px 18px;border-radius:999px;background:var(--grad);color:#040810;font-weight:700;border:none;cursor:none;transition:transform .15s,box-shadow .25s;box-shadow:0 6px 24px rgba(124,131,255,.4); }
  .nav-btn:hover { transform:translateY(-1px) scale(1.03);box-shadow:0 8px 32px rgba(124,131,255,.6); }

  /* === MAGNETIC BUTTON === */
  .magnetic-wrap { display:inline-block;position:relative;overflow:visible; }

  /* === HERO === */
  .hero { min-height:100vh;display:grid;grid-template-columns:1fr 1fr;align-items:center;padding:140px 0 80px;gap:60px;position:relative; }
  .hero-left { animation:fadeUp .9s ease both;animation-delay:.15s; }
  @keyframes fadeUp { from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)} }

  .badge { display:inline-flex;align-items:center;gap:8px;font-family:'JetBrains Mono',monospace;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut2);
    border:1px solid var(--line);background:rgba(124,131,255,.06);padding:7px 16px;border-radius:999px;margin-bottom:28px;backdrop-filter:blur(8px); }
  .badge-dot { width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 12px var(--ok);animation:pulseDot 1.8s infinite; }
  @keyframes pulseDot { 0%,100%{opacity:1;transform:scale(1)}50%{opacity:.4;transform:scale(.7)} }

  .hero h1 { font-size:clamp(42px,6vw,78px);line-height:1.02;letter-spacing:-.04em;font-weight:900;margin-bottom:24px; }
  .hero h1 .g { background:linear-gradient(135deg,#7c83ff,#22d3ee 40%,#a855f7 80%,#ff6b9d);-webkit-background-clip:text;background-clip:text;color:transparent;
    background-size:200% 200%;animation:gradientShift 6s ease infinite; }
  @keyframes gradientShift { 0%,100%{background-position:0% 50%}50%{background-position:100% 50%} }

  .hero p { color:var(--mut);font-size:18px;max-width:460px;margin-bottom:32px;line-height:1.7;font-weight:400; }

  .hero-actions { display:flex;gap:14px;flex-wrap:wrap;align-items:center; }

  .btn-primary { position:relative;font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:700;padding:15px 30px;border-radius:16px;background:var(--grad);color:#040810;
    border:none;cursor:none;overflow:hidden;transition:transform .15s,box-shadow .3s;box-shadow:0 8px 32px rgba(124,131,255,.45); }
  .btn-primary::before { content:'';position:absolute;inset:0;background:linear-gradient(135deg,transparent 40%,rgba(255,255,255,.45) 50%,transparent 60%);transform:translateX(-120%);transition:transform .8s; }
  .btn-primary:hover::before { transform:translateX(120%); }
  .btn-primary:hover { transform:translateY(-3px) scale(1.03);box-shadow:0 16px 48px rgba(124,131,255,.6); }

  .btn-ghost { font-family:'JetBrains Mono',monospace;font-size:14px;font-weight:600;padding:15px 28px;border-radius:16px;background:var(--glass);color:var(--txt);
    border:1px solid var(--line);cursor:none;backdrop-filter:blur(10px);transition:border-color .2s,background .2s,transform .15s; }
  .btn-ghost:hover { border-color:rgba(124,131,255,.4);background:rgba(255,255,255,.07);transform:translateY(-2px); }

  .hero-stats { display:flex;gap:36px;margin-top:44px;padding-top:32px;border-top:1px solid var(--line);flex-wrap:wrap; }
  .hero-stat .val { font-family:'JetBrains Mono',monospace;font-size:28px;font-weight:700;letter-spacing:-.02em; }
  .hero-stat .lbl { font-size:12.5px;color:var(--mut2);margin-top:4px;font-weight:500; }

  /* === HERO WEBGL / 3D === */
  .hero-right { position:relative;display:grid;place-items:center;height:680px;perspective:1200px; }
  #webgl-canvas { width:100%;height:100%;position:absolute;inset:0; }

  /* Floating price cards */
  .float-price { position:absolute;width:195px;padding:14px 16px;background:rgba(10,14,30,.75);backdrop-filter:blur(20px) saturate(1.4);border:1px solid rgba(255,255,255,.1);
    border-radius:18px;box-shadow:0 12px 40px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.06);z-index:5;transition:transform .3s; }
  .float-price:hover { transform:translateY(-4px) scale(1.03); }
  .fp-top { display:flex;align-items:center;gap:9px;margin-bottom:8px;font-size:12px;color:var(--mut);font-family:'JetBrains Mono',monospace; }
  .fp-top .sym { font-weight:600;font-size:13px;color:var(--txt); }
  .fp-change { margin-left:auto;font-weight:700;font-size:12.5px; }
  .fp-change.up { color:var(--ok); } .fp-change.down { color:var(--err); }
  .fp-price { font-family:'JetBrains Mono',monospace;font-size:19px;font-weight:700;letter-spacing:-.01em; }

  /* Stats ticker */
  .stats-ticker { position:absolute;bottom:30px;left:50%;transform:translateX(-50%);display:flex;gap:28px;padding:14px 28px;background:rgba(10,14,30,.7);backdrop-filter:blur(16px);
    border:1px solid var(--line);border-radius:999px;font-family:'JetBrains Mono',monospace;z-index:5; }
  .st-item { display:flex;align-items:center;gap:8px;font-size:12.5px;color:var(--mut);white-space:nowrap; }
  .st-item b { color:var(--txt);font-weight:600; }

  /* === SECTIONS === */
  section { padding:90px 0;position:relative; }
  .section-badge { display:inline-flex;align-items:center;gap:7px;font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut);
    border:1px solid var(--line);background:rgba(124,131,255,.05);padding:6px 14px;border-radius:999px;margin-bottom:18px; }

  .section-title { font-size:clamp(30px,4vw,52px);font-weight:800;letter-spacing:-.03em;line-height:1.08;margin-bottom:16px; }
  .section-sub { color:var(--mut);font-size:17px;max-width:600px;line-height:1.65; }

  /* === BUILDER SECTION === */
  .builder-wrap { display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:44px; }
  .builder-card { background:rgba(10,14,30,.65);backdrop-filter:blur(18px) saturate(1.3);border:1px solid var(--line);border-radius:22px;overflow:hidden;
    box-shadow:0 20px 60px rgba(0,0,0,.4),inset 0 1px 0 rgba(255,255,255,.04);transition:border-color .3s,box-shadow .3s; }
  .builder-card:hover { border-color:rgba(124,131,255,.25);box-shadow:0 24px 70px rgba(0,0,0,.5),inset 0 1px 0 rgba(255,255,255,.06); }
  .bc-head { display:flex;align-items:center;gap:10px;padding:14px 16px;border-bottom:1px solid var(--line);font-size:13px;font-weight:600; }
  .bc-search { display:flex;align-items:center;gap:7px;flex:1;background:rgba(0,0,0,.35);border:1px solid var(--line);border-radius:11px;padding:9px 13px;transition:border-color .2s; }
  .bc-search:focus-within { border-color:var(--acc);box-shadow:0 0 0 3px rgba(124,131,255,.12); }
  .bc-search svg { width:14px;height:14px;color:var(--mut2);flex:none; }
  .bc-search input { background:0 0;border:0;color:var(--txt);font:inherit;font-size:13px;width:100%;outline:0; }

  .chain-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(165px,1fr));gap:12px;max-height:400px;overflow-y:auto;padding:16px;scrollbar-width:thin; }
  .chain-grid::-webkit-scrollbar { width:5px; } .chain-grid::-webkit-scrollbar-thumb { background:rgba(255,255,255,.1);border-radius:3px; }

  /* 3D Tilt Coin Cards */
  .coin-card-3d { position:relative;background:rgba(255,255,255,.03);border:1.5px solid var(--line);border-radius:18px;padding:16px;cursor:none;user-select:none;
    transition:border-color .2s,transform .15s,box-shadow .25s;transform-style:preserve-3d;perspective:600px; }
  .coin-card-3d:hover { border-color:rgba(124,131,255,.4);box-shadow:0 12px 36px -12px rgba(124,131,255,.3),inset 0 1px 0 rgba(255,255,255,.06); }
  .coin-card-3d.selected { border-color:var(--acc);background:linear-gradient(170deg,rgba(124,131,255,.12),rgba(34,211,238,.03));box-shadow:0 0 0 1px rgba(124,131,255,.2); }
  .cc-top { display:flex;align-items:center;gap:11px;position:relative;z-index:2; }
  .cc-sphere { width:40px;height:40px;border-radius:50%;display:grid;place-items:center;font-size:13px;font-weight:800;color:#fff;flex:none;position:relative;overflow:hidden;
    background:radial-gradient(circle at 32% 28%,rgba(255,255,255,.4),transparent 45%),var(--cc);box-shadow:0 6px 18px -4px var(--cc),inset 0 1px 2px rgba(255,255,255,.2); }
  .cc-name { font-weight:650;font-size:14.5px;position:relative;z-index:2; }
  .cc-id { font-size:11px;color:var(--mut2);font-family:'JetBrains Mono',monospace;position:relative;z-index:2; }
  .cc-check { position:absolute;top:10px;right:11px;width:20px;height:20px;border-radius:50%;background:var(--grad);display:none;place-items:center;font-size:11px;font-weight:800;color:#040810;
    box-shadow:0 2px 8px rgba(124,131,255,.5);z-index:3; }
  .coin-card-3d.selected .cc-check { display:grid; }
  .cc-pct { display:none;margin-top:12px;font-size:12px;color:var(--mut2);font-family:'JetBrains Mono',monospace;align-items:center;gap:6px;position:relative;z-index:2; }
  .coin-card-3d.selected .cc-pct { display:flex; }
  .cc-pct input { width:70px;background:rgba(0,0,0,.4);border:1px solid var(--line);border-radius:8px;color:var(--txt);font-family:'JetBrains Mono',monospace;font-size:12.5px;text-align:right;padding:6px 8px;outline:0;border-color:transparent;transition:border-color .15s; }
  .cc-pct input:focus { border-color:var(--acc); }

  /* Basket */
  .bc-body { padding:8px 16px;min-height:132px;max-height:304px;overflow-y:auto;scrollbar-width:thin; }
  .basket-empty { color:var(--mut2);font-family:'JetBrains Mono',monospace;font-size:13px;text-align:center;padding:50px 12px;line-height:1.8; }
  .br { display:grid;grid-template-columns:16px 54px 1fr 54px 22px;align-items:center;gap:10px;padding:11px 0;border-bottom:1px solid rgba(255,255,255,.03);font-size:13px; }
  .br:last-child { border-bottom:none; }
  .br-sym { font-family:'JetBrains Mono',monospace;font-weight:600;color:var(--txt);font-size:12.5px; }
  .br-slider { display:flex;align-items:center;gap:5px;width:100%; }
  .br-slider input[type=range] { -webkit-appearance:none;appearance:none;flex:1;height:5px;border-radius:3px;outline:0;cursor:none;background:linear-gradient(90deg,var(--val) 0%,var(--val) var(--pct),var(--panel3,var(--bg)) var(--pct),var(--bg) 100%); }
  .br-slider input[type=range]::-webkit-slider-thumb { -webkit-appearance:none;width:15px;height:15px;border-radius:50%;background:#fff;cursor:none;box-shadow:0 2px 8px rgba(0,0,0,.4); }
  .br-pct { font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--mut);min-width:42px;text-align:right; }
  .br-remove { width:22px;height:22px;border-radius:7px;display:grid;place-items:center;background:0 0;color:var(--mut2);font-size:16px;line-height:1;transition:.15s;cursor:none; }
  .br-remove:hover { color:var(--err);background:rgba(239,68,68,.1); }

  /* Meter */
  .meter-wrap { display:flex;align-items:center;gap:10px;padding:14px 16px 4px;border-top:1px solid var(--line); }
  .meter-track { flex:1;height:7px;background:rgba(255,255,255,.06);border-radius:4px;overflow:hidden; }
  .meter-fill { height:100%;background:var(--mut2);border-radius:4px;transition:width .3s,background .3s;width:0; }
  .meter-fill.ok { background:var(--ok);box-shadow:0 0 12px var(--ok); } .meter-fill.over { background:var(--err); }
  .sum-line { font-family:'JetBrains Mono',monospace;font-size:12px;color:var(--ok);margin-top:8px;padding:0 16px;letter-spacing:.03em; }
  .sum-line.bad { color:var(--warn); }

  /* Basket footer */
  .basket-footer { padding:14px 16px 16px;display:flex;flex-direction:column;gap:12px; }
  .field { display:flex;flex-direction:column;gap:6px; }
  .field label { font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--mut2);letter-spacing:.1em;text-transform:uppercase; }
  .field input { background:rgba(0,0,0,.35);border:1px solid var(--line);color:var(--txt);padding:12px 14px;font:inherit;font-size:14.5px;border-radius:12px;outline:0;border-color:transparent;transition:border-color .15s; }
  .field input:focus { border-color:var(--acc);box-shadow:0 0 0 3px rgba(124,131,255,.12); }
  .grid-2 { display:grid;grid-template-columns:1fr 1fr;gap:12px; }

  /* Composition Donut */
  .alloc-donut { background:rgba(0,0,0,.28);border:1px solid var(--line);border-radius:20px;padding:20px;margin-top:20px;min-height:60px;display:flex;align-items:center;gap:24px;flex-wrap:wrap; }
  .pie-ring { width:120px;height:120px;border-radius:50%;flex:none;filter:drop-shadow(0 8px 24px rgba(124,131,255,.3));position:relative; }
  .pie-hole { position:absolute;inset:26px;border-radius:50%;background:rgba(10,14,30,.9);display:grid;place-items:center;text-align:center;line-height:1.05; }
  .pie-hole b { font-size:22px;font-weight:800; }.pie-hole span { font-size:9px;color:var(--mut2);text-transform:uppercase;letter-spacing:.1em;display:block;margin-top:3px; }
  .leg-list { display:flex;flex-direction:column;gap:7px;flex:1;min-width:120px; }
  .leg-r { display:flex;align-items:center;gap:9px;font-size:13.5px;font-weight:600; }
  .leg-dot { width:11px;height:11px;border-radius:4px;flex:none;box-shadow:0 0 8px -2px currentColor; }

  /* Portfolio cards */
  #pf-list { display:flex;flex-direction:column;gap:12px;margin-top:32px; }
  .pf-card { display:flex;align-items:center;gap:16px;padding:16px 20px;background:rgba(10,14,30,.55);backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:18px;
    cursor:none;transition:border-color .2s,background .2s,transform .15s; }
  .pf-card:hover { border-color:rgba(124,131,255,.35);background:rgba(124,131,255,.06);transform:translateY(-2px); }
  .pf-card.active { border-color:var(--acc);background:linear-gradient(170deg,rgba(124,131,255,.1),rgba(34,211,238,.03)); }
  .pf-dots { display:flex;gap:-4px;flex:none; }
  .pf-dot { width:19px;height:19px;border-radius:50%;border:2.5px solid var(--bg);margin-left:-6px; }
  .pf-dot:first-child { margin-left:0; }
  .pf-info { flex:1;min-width:0; } .pf-name { font-weight:700;font-size:15px; }.pf-sub { font-size:12px;color:var(--mut2);font-family:'JetBrains Mono',monospace;margin-top:2px; }

  /* Token detail */
  .token-detail { display:grid;grid-template-columns:1fr 1.1fr;gap:30px;margin-top:36px; }
  .td-panel { background:rgba(10,14,30,.55);backdrop-filter:blur(12px);border:1px solid var(--line);border-radius:20px;padding:22px;box-shadow:0 12px 40px rgba(0,0,0,.3); }
  .td-sub { font-family:'JetBrains Mono',monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut2);margin-bottom:14px;font-weight:650; }

  /* Invest form */
  .amt-box { display:flex;align-items:center;gap:12px;background:rgba(0,0,0,.35);border:1px solid var(--line);border-radius:16px;padding:12px 12px 12px 18px;transition:border-color .15s; }
  .amt-box:focus-within { border-color:var(--acc);box-shadow:0 0 0 3px rgba(124,131,255,.12); }
  .amt-box input { background:0 0;border:0;color:var(--txt);font-family:'JetBrains Mono',monospace;font-size:32px;font-weight:700;width:100%;letter-spacing:-.02em;outline:0; }
  .ticker-tag { display:flex;align-items:center;gap:7px;background:rgba(255,255,255,.06);border:1px solid var(--line);padding:9px 14px;border-radius:12px;font-family:'JetBrains Mono',monospace;font-weight:600;font-size:14px;color:var(--mut);white-space:nowrap; }

  /* Status */
  .status { display:none;align-items:center;gap:10px;margin-top:14px;padding:13px 16px;border-radius:13px;background:rgba(0,0,0,.28);border:1px solid var(--line);font-family:'JetBrains Mono',monospace;font-size:12.5px; }
  .status.show { display:flex; }
  .s-dot { width:9px;height:9px;border-radius:50%;flex:none;background:var(--mut2); }
  .status.work .s-dot { background:var(--accent2);animation:pulseDot 1s infinite; }.status.ok .s-dot { background:var(--ok);box-shadow:0 0 10px var(--ok); }.status.err .s-dot { background:var(--err); }
  .s-spin { width:14px;height:14px;border:2px solid var(--line);border-top-color:var(--accent2);border-radius:50%;animation:spinX .7s linear infinite;flex:none; }
  @keyframes spinX { to{transform:rotate(360deg)} }

  /* Stats display */
  .stat-big { font-size:13px;color:var(--mut);font-weight:650;text-transform:uppercase;letter-spacing:.08em;margin-top:22px; }
  .stat-big b { display:block;font-size:36px;color:var(--txt);font-weight:800;letter-spacing:-.03em;margin-top:4px;font-family:'JetBrains Mono',monospace; }

  /* Activity log */
  .activity-box { margin:40px 0;border-radius:20px;background:rgba(10,14,30,.5);backdrop-filter:blur(12px);border:1px solid var(--line);overflow:hidden; }
  .activity-box summary { cursor:pointer;padding:16px 24px;font-family:'JetBrains Mono',monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);list-style:none;display:flex;align-items:center;gap:10px; }
  .activity-box summary::-webkit-details-marker { display:none; }
  .activity-box summary::before { content:'+';color:var(--accent2);font-size:16px;font-weight:700;transition:transform .2s; } .activity-box[open] summary::before { transform:rotate(45deg); }
  #act-log { font-family:'JetBrains Mono',monospace;font-size:12.5px;padding:0 24px 20px;max-height:240px;overflow:auto;white-space:pre-wrap;color:var(--mut2);line-height:1.7; }

  /* Modal */
  .overlay { position:fixed;inset:0;background:rgba(3,5,12,.68);backdrop-filter:blur(8px);display:none;place-items:center;z-index:90; }
  .overlay.show { display:grid;animation:fadeInX .2s ease; }
  @keyframes fadeInX { from{opacity:0}to{opacity:1} }
  .modal-box { background:linear-gradient(170deg,#111833,#0c1228);border:1px solid var(--line);border-radius:26px;padding:34px;width:420px;max-width:90vw;box-shadow:0 50px 120px rgba(0,0,0,.7);animation:slideUpX .3s ease;position:relative; }
  @keyframes slideUpX { from{opacity:0;transform:translateY(40px)}to{opacity:1;transform:translateY(0)} }
  .modal-box h3 { font-size:22px;font-weight:800;letter-spacing:-.02em;margin-bottom:6px; } .modal-box>p { color:var(--mut);font-size:13.5px;margin-bottom:24px;line-height:1.55; }
  .opt-item { display:flex;align-items:center;gap:14px;width:100%;text-align:left;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:16px;padding:16px;color:var(--txt);transition:border-color .2s,background .15s,transform .1s;cursor:none; }
  .opt-item:hover { border-color:rgba(124,131,255,.4);background:rgba(124,131,255,.08);transform:translateY(-2px); }
  .opt-ic { width:44px;height:44px;border-radius:13px;display:grid;place-items:center;font-size:17px;flex:none; }
  .opt-t { font-weight:700;font-size:15.5px; }.opt-d { font-size:12px;color:var(--mut2);font-family:'JetBrains Mono',monospace;margin-top:3px; }
  .modal-note { font-size:11px;color:var(--mut2);text-align:center;margin-top:10px;font-family:'JetBrains Mono',monospace;letter-spacing:.02em; }
  .modal-x { position:absolute;top:18px;right:20px;color:var(--mut);cursor:none;font-size:24px;line-height:1;transition:color .15s; } .modal-x:hover { color:var(--accent2); }

  /* Toasts */
  #toast-box { position:fixed;right:28px;bottom:28px;display:flex;flex-direction:column;gap:10px;z-index:95; }
  .toast-item { background:linear-gradient(170deg,#141c36,#0e1428);border:1px solid var(--line);border-left:3px solid var(--accent2);border-radius:14px;padding:14px 18px;
    font-family:'JetBrains Mono',monospace;font-size:13px;min-width:260px;max-width:390px;box-shadow:0 20px 56px rgba(0,0,0,.5);animation:toastIn .3s ease; }
  .toast-item.ok { border-left-color:var(--ok); }.toast-item.err { border-left-color:var(--err); }
  @keyframes toastIn { from{transform:translateX(30px);opacity:0}to{transform:translateX(0);opacity:1} }

  /* Footer */
  footer { font-family:'JetBrains Mono',monospace;color:var(--mut2);font-size:11.5px;text-align:center;padding:40px 0 50px;letter-spacing:.06em;text-transform:uppercase; }

  /* Reveal animation classes */
  .reveal { opacity:0;transform:translateY(50px);transition:opacity .7s ease,transform .7s ease; }
  .reveal.visible { opacity:1;transform:translateY(0); }
  .reveal-left { opacity:0;transform:translateX(-50px);transition:opacity .7s ease,transform .7s ease; }
  .reveal-left.visible { opacity:1;transform:translateX(0); }

  /* Scroll progress bar */
  .scroll-progress { position:fixed;top:0;left:0;height:2px;background:var(--grad);z-index:200;width:0%;transition:width .08s linear; }

  @media(max-width:960px){ .hero{grid-template-columns:1fr;min-height:auto;padding-top:110px;text-align:center;}.hero-right{display:none;}.builder-wrap{grid-template-columns:1fr;}.token-detail{grid-template-columns:1fr;}.nav-links{display:none;}.hero-stats,.hero-actions,.hero p{justify-content:center;} .float-price{display:none!important;}.stats-ticker{flex-wrap:wrap;width:90%;justify-content:center;font-size:11px;padding:12px 16px;} }
</style>
</head>
<body>

<!-- Scroll progress -->
<div class="scroll-progress" id="scrollProgress"></div>

<!-- Custom cursor -->
<div class="cursor-ring" id="cursorRing"></div>
<div class="cursor-dot" id="cursorDot"></div>

<!-- WebGL BG -->
<canvas id="bgCanvas"></canvas>
<div class="noise"></div>

<!-- Navbar -->
<div class="navbar" id="navbar">
  <div class="nav-logo">X</div>
  <div class="nav-links">
    <a href="#builder">Build</a><a href="#investCard">Invest</a><a href="#pfCard">Portfolio</a>
  </div>
  <button class="nav-btn magnetic" data-mag id="connectBtn">Connect</button>
</div>

<div class="wrap">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-left">
      <div class="badge"><span class="badge-dot"></span> Onchain Index Protocol · Sepolia</div>
      <h1>The Future of<br /><span class="g">Cross-Chain Indexes</span></h1>
      <p>Build diversified indexes across 15+ chains — BTC, ETH, SOL and more. Invest with USDT, redeem anytime. All natively settled.</p>
      <div class="hero-actions">
        <button class="btn-primary magnetic" data-mag id="heroCta">Launch App →</button>
        <a href="#builder" class="btn-ghost magnetic" data-mag>Magic Protocol</a>
      </div>
      <div class="hero-stats">
        <div class="hero-stat"><div class="val" data-count="15">0</div><div class="lbl">Chains</div></div>
        <div class="hero-stat"><div class="val" data-count="200">0</div><div class="lbl">Assets</div></div>
        <div class="hero-stat"><div class="val">$<span data-count="47">0</span>M</div><div class="lbl">TVL (simulated)</div></div>
      </div>
    </div>

    <div class="hero-right" id="heroRight">
      <canvas id="webgl-canvas"></canvas>

      <!-- Floating price cards -->
      <div class="float-price" style="left:-60px;top:18%;animation:floatC 5.5s ease-in-out infinite;">
        <div class="fp-top"><span style="width:16px;height:16px;border-radius:50%;background:#f7931a;display:inline-block"></span><span class="sym">BTC</span><span class="fp-change up">+2.4%</span></div>
        <div class="fp-price">$97,420</div>
      </div>
      <div class="float-price" style="right:-50px;bottom:18%;animation:floatC 6.5s 1s ease-in-out infinite;">
        <div class="fp-top"><span style="width:16px;height:16px;border-radius:50%;background:#627eea;display:inline-block"></span><span class="sym">ETH</span><span class="fp-change up">+1.8%</span></div>
        <div class="fp-price">$3,842</div>
      </div>

      <!-- Stats ticker -->
      <div class="stats-ticker">
        <div class="st-item">⛽ Gas: <b>$0.02</b></div>
        <div class="st-item">📊 Indices: <b>1,247</b></div>
        <div class="st-item">💰 Deposited: <b>12.8M</b></div>
      </div>
    </div>
  </section>

  <!-- BUILDER -->
  <section id="builder">
    <div class="reveal">
      <div class="section-badge">◈ Step 01</div>
      <h2 class="section-title">Build Your Index</h2>
      <p class="section-sub">Select from 15 native chains, adjust each allocation weight, and create a cross-chain index fund — all on-chain.</p>
    </div>

    <div class="builder-wrap reveal" style="transition-delay:.1s">
      <div class="builder-card">
        <div class="bc-head">Marketplace</div>
        <div class="bc-search"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg><input id="assetSearch" placeholder="Search chains & assets…" autocomplete="off" /></div>
        <div class="chain-grid" id="chains"></div>
      </div>

      <div class="builder-card">
        <div class="bc-head"><span>Your Index</span><span style="font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--mut2)" id="basketN">0 assets</span></div>
        <div class="bc-body" id="basketList"></div>
        <div class="meter-wrap"><div class="meter-track"><div class="meter-fill" id="meterFill"></div></div></div>
        <div class="sum-line" id="sumLine">Total: 0%</div>
        <div class="basket-footer">
          <div class="grid-2">
            <div class="field"><label>Name</label><input id="bName" value="My Index" /></div>
            <div class="field"><label>Ticker</label><input id="bSym" value="MYX" /></div>
          </div>
          <button class="btn-primary magnetic" data-mag id="createBtn" style="width:100%">Create Index →</button>
        </div>
      </div>
    </div>
  </section>

  <!-- PORTFOLIOS -->
  <section id="pfCard">
    <div class="reveal">
      <div class="section-badge">◈ Portfolios</div>
      <h2 class="section-title">My Indexes</h2>
      <p class="section-sub">All indexes are persisted locally on your device.</p>
    </div>
    <div id="pf-list" class="reveal"></div>
  </section>

  <!-- INVEST / TOKEN DETAIL -->
  <section id="investCard">
    <div class="reveal">
      <div class="section-badge">◈ Invest</div>
      <h2 class="section-title">Your Index Token</h2>
    </div>
    <div class="token-detail reveal" style="transition-delay:.1s">
      <div class="td-panel" id="compositionPanel">
        <div class="td-sub">Composition</div>
        <div class="alloc-donut empty" id="posAlloc"><span style="color:var(--mut2);font-family:'JetBrains Mono',monospace;font-size:14px;">Select coins to preview your mix.</span></div>
        <div class="stat-big">Your Balance<b><span id="posShares">0</span> <span style="font-size:16px;color:var(--mut);font-weight:500;">shares</span></b></div>
      </div>
      <div class="td-panel" style="display:flex;flex-direction:column;gap:20px;">
        <div>
          <div class="td-sub">Invest with USDT</div>
          <div class="amt-box"><input id="mintAmt" type="number" value="1000" min="0" /><span class="ticker-tag">💵 USDT</span></div>
          <p style="font-size:13px;color:var(--mut);margin-top:10px;">Balance: <b id="usdtHave" style="color:var(--txt)">0 USDT</b> · <a href="#" id="faucet" style="color:var(--accent2)">Get 10,000 test USDT →</a></p>
          <button class="btn-primary magnetic" data-mag id="mintBtn" style="width:100%;margin-top:4px">Invest Now →</button>
        </div>
        <div>
          <div class="td-sub">Redeem to USDT</div>
          <div class="field"><label>Shares → USDT</label><input id="burnAmt" type="number" value="0" min="0" /></div>
          <button class="btn-ghost magnetic" data-mag id="burnBtn" style="width:100%;margin-top:4px">Cash Out</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Activity -->
  <details class="activity-box reveal"><summary>Activity Log</summary><div id="act-log"></div></details>

  <footer>Xindex Protocol · Decentralized Cross-Chain Indexes · Testnet Demo</footer>
</div>

<!-- Modal -->
<div class="overlay" id="overlay">
  <div class="modal-box">
    <span class="modal-x" id="modalX">×</span>
    <h3>Connect Wallet</h3>
    <p>Testnet demo environment — no real assets involved.</p>
    <button class="opt-item" id="optDemo"><span class="opt-ic" style="background:var(--grad);color:#040810">▸</span><div><div class="opt-t">Demo Wallet</div><div class="opt-d">Funded & ready · 1-click</div></div></button>
    <button class="opt-item" id="optMM"><span class="opt-ic" style="background:#f6851b">🦊</span><div><div class="opt-t">MetaMask</div><div class="opt-d">Connect to Sepolia testnet</div></div></button>
    <p class="modal-note">Test environment only · no real funds at risk.</p>
  </div>
</div>

<div id="toast-box"></div>

<script>
/* === CONFIGURATION === */
const META = {
  "BTC.BTC":{n:"Bitcoin",s:"BTC",c:"#f7931a",g:"₿"},"ETH.ETH":{n:"Ethereum",s:"ETH",c:"#627eea",g:"Ξ"},
  "BCH.BCH":{n:"Bitcoin Cash",s:"BCH",c:"#0ac18e"},"LTC.LTC":{n:"Litecoin",s:"LTC",c:"#345d9d",g:"Ł"},
  "DOGE.DOGE":{n:"Dogecoin",s:"DOGE",c:"#c2a633",g:"Ð"},"AVAX.AVAX":{n:"Avalanche",s:"AVAX",c:"#e84142"},
  "BSC.BNB":{n:"BNB Chain",s:"BNB",c:"#f3ba2f"},"GAIA.ATOM":{n:"Cosmos",s:"ATOM",c:"#6f7390"},
  "BASE.ETH":{n:"Base",s:"ETH",c:"#0052ff"},"XRP.XRP":{n:"XRP",s:"XRP",c:"#3aa9d6"},
  "ZEC.ZEC":{n:"Zcash",s:"ZEC",c:"#e5a200"},"POL.MATIC":{n:"Polygon",s:"POL",c:"#8247e5"},
  "NOBLE.USDC":{n:"Noble USDC",s:"USDC",c:"#2775ca"},"SOL.SOL":{n:"Solana",s:"SOL",c:"#14f195"},
  "TRON.TRX":{n:"Tron",s:"TRX",c:"#eb0029"}
};
const meta = a => META[a] || { n:a, s:a.split('.')[0], c:'#8a8fa3' };
const ASSETS = Object.keys(META);
const ICON_BASE = 'https://cdn.jsdelivr.net/npm/cryptocurrency-icons@0.18.1/svg/color/';

/* === STATE === */
let sel = new Map(); let baskets = []; let activePf = null; const pfs = [];
const $ = id => document.getElementById(id);
const short = a => a.slice(0,6)+'…'+a.slice(-4);
const sleep = ms => new Promise(r => setTimeout(r, ms));

/* === CUSTOM CURSOR === */
(function(){
  const ring=$('cursorRing'), dot=$('cursorDot'); if(!ring||!dot) return;
  let mx=0, my=0, rx=0, ry=0;
  document.addEventListener('mousemove', e => { mx=e.clientX; my=e.clientY; dot.style.left=mx+'px'; dot.style.top=my+'px'; });
  function animRing(){ rx+=(mx-rx)*.15; ry+=(my-ry)*.15; ring.style.left=rx+'px'; ring.style.top=ry+'px'; requestAnimationFrame(animRing); }
  animRing();
  document.addEventListener('mousedown', () => { ring.style.width='28px'; ring.style.height='28px'; ring.style.borderColor='rgba(34,211,238,.8)'; });
  document.addEventListener('mouseup', () => { ring.style.width='40px'; ring.style.height='40px'; ring.style.borderColor='rgba(124,131,255,.5)'; });
})();

/* === CANVAS NOISE BACKGROUND === */
(function(){
  const c=$('bgCanvas'); if(!c) return;
  const ctx=c.getContext('2d'); let w,h,t=0;
  function resize(){w=c.width=window.innerWidth;h=c.height=window.innerHeight;}
  resize(); window.addEventListener('resize',resize);
  // Simplex-like noise using layered sine waves
  function noise(x,y,z){return Math.sin(x*1.3+z)*Math.cos(y*0.9+z*.7)*.5+Math.sin(x*2.7+z*1.3)*Math.sin(y*2.1-z*.4)*.25;}
  function draw(){
    t+=.003; ctx.clearRect(0,0,w,h);
    const res=30;
    for(let x=0;x<w;x+=res){for(let y=0;y<h;y+=res){
      const n=noise(x/w,y/h,t), r=n*255+127, g=(noise(x/w+.5,y/h+t*.3)*255+127)|0;
      const b=Math.abs(noise(x/w-t*.4,y/h+.7,t*.8))*200+55;
      ctx.fillStyle=`rgba(${r|0},${g|0},${b|0},${Math.max(0,n*.03)})`;
      ctx.fillRect(x,y,res-1,res-1);
    }}
    requestAnimationFrame(draw);
  } draw();
})();

/* === THREE.JS WEBGL HERO === */
(function(){
  const canvas=$('webgl-canvas'); if(!canvas) return;
  const renderer=new THREE.WebGLRenderer({canvas,alpha:true,antialias:true});
  renderer.setSize(canvas.parentElement.clientWidth, canvas.parentElement.clientHeight);
  renderer.setPixelRatio(Math.min(window.devicePixelRatio,2));

  const scene=new THREE.Scene();
  const camera=new THREE.PerspectiveCamera(60,1,.1,100);
  camera.position.z=3.5;

  // Sphere with displacement shader
  const sphereGeo=new THREE.SphereGeometry(1,80,80);
  const vertShader=`
    uniform float uTime;
    varying vec3 vNormal;
    varying vec2 vUv;
    varying float vDisplacement;
    void main(){
      vUv=uv; vNormal=normalize(normalMatrix*normal);
      float disp=sin(position.x*3.0+uTime)*sin(position.y*2.5+uTime*.7)*sin(position.z*2.0+uTime*.5)*.06;
      vec3 newPos=position+normal*disp;
      vDisplacement=disp;
      gl_Position=projectionMatrix*modelViewMatrix*vec4(newPos,1.0);
    }`;
  const fragShader=`
    uniform float uTime;
    varying vec3 vNormal;
    varying vec2 vUv;
    varying float vDisplacement;
    void main(){
      vec3 col1=vec3(.486,.514,1.0); // #7c83ff
      vec3 col2=vec3(.133,.827,.898); // #22d3ee
      vec3 col3=vec3(.659,.333,.969); // #a855f7
      float t=vDisplacement*4.0+sin(uTime*.3)*.3+.5;
      vec3 col=mix(col1,col2,t);
      col=mix(col,col3,vDisplacement*2.0+.5);
      float fresnel=pow(1.0-dot(vNormal,vec3(0,0,1)),3.0);
      col+=fresnel*vec3(.3,.4,.6)*.5;
      gl_FragColor=vec4(col,1.0);
    }`;
  const sphereMat=new THREE.ShaderMaterial({vertexShader:vertShader,fragmentShader:fragShader,uniforms:{uTime:{value:0}}});
  const sphere=new THREE.Mesh(sphereGeo,sphereMat);
  scene.add(sphere);

  // Wireframe overlay
  const wireMat=new THREE.MeshBasicMaterial({color:'#22d3ee',wireframe:true,transparent:true,opacity:.08});
  const wireSphere=new THREE.Mesh(new THREE.SphereGeometry(1.01,30,30),wireMat);
  scene.add(wireSphere);

  // Ring particles orbiting
  const ringCount=200;
  const ringGeo=new THREE.BufferGeometry();
  const ringPos=new Float32Array(ringCount*3);
  for(let i=0;i<ringCount;i++){
    const a=(i/ringCount)*Math.PI*2;const r=1.8+Math.random()*.4;
    ringPos[i*3]=Math.cos(a)*r; ringPos[i*3+1]=(Math.random()-.5)*.3; ringPos[i*3+2]=Math.sin(a)*r;
  }
  ringGeo.setAttribute('position',new THREE.BufferAttribute(ringPos,3));
  const ringMat=new THREE.PointsMaterial({color:'#7c83ff',size:.03,transparent:true,opacity:.5});
  const ringPoints=new THREE.Points(ringGeo,ringMat);
  scene.add(ringPoints);

  // Second ring tilted differently
  const ring2Count=150;
  const ring2Geo=new THREE.BufferGeometry();
  const ring2Pos=new Float32Array(ring2Count*3);
  for(let i=0;i<ring2Count;i++){
    const a=(i/ring2Count)*Math.PI*2;const r=2.4+Math.random()*.5;
    ring2Pos[i*3]=Math.cos(a)*r; ring2Pos[i*3+1]=(Math.random()-.5)*.5; ring2Pos[i*3+2]=Math.sin(a)*r;
  }
  ring2Geo.setAttribute('position',new THREE.BufferAttribute(ring2Pos,3));
  const ring2Points=new THREE.Points(ring2Geo,new THREE.PointsMaterial({color:'#a855f7',size:.025,transparent:true,opacity:.4}));
  ring2Points.rotation.x=Math.PI*.3;scene.add(ring2Points);

  // Mouse parallax
  let mouseX=0,mouseY=0;
  document.addEventListener('mousemove',e=>{mouseX=(e.clientX/window.innerWidth-.5)*.3;mouseY=(e.clientY/window.innerHeight-.5)*.2;});

  function animate(){
    requestAnimationFrame(animate);
    sphereMat.uniforms.uTime.value+=.01;
    sphere.rotation.y+=.003; wireSphere.rotation.y-=.002; wireSphere.rotation.x=Math.sin(sphereMat.uniforms.uTime.value*.5)*.1;
    ringPoints.rotation.y+=.004;ringPoints.rotation.x+=.001;
    ring2Points.rotation.y-=.003;
    sphere.position.x+=(mouseX*-.6-sphere.position.x)*.05;
    sphere.position.y+=(mouseY*.4-sphere.position.y)*.05;
    wireSphere.position.copy(sphere.position);ringPoints.position.copy(sphere.position);ring2Points.position.copy(sphere.position);
    renderer.render(scene,camera);
  } animate();

  window.addEventListener('resize',()=>{
    const w=canvas.parentElement.clientWidth,h=canvas.parentElement.clientHeight;
    camera.aspect=w/h;camera.updateProjectionMatrix();renderer.setSize(w,h);
  });
})();

/* === MAGNETIC BUTTONS === */
document.querySelectorAll('[data-mag]').forEach(btn=>{
  btn.addEventListener('mousemove',e=>{const r=btn.getBoundingClientRect();const x=e.clientX-r.left-r.width/2;const y=e.clientY-r.top-r.height/2;btn.style.transform=`translate(${x*.3}px,${y*.3}px) scale(1.04)`;});
  btn.addEventListener('mouseleave',()=>{btn.style.transform='';});
});

/* === CURSOR HOVER ON INTERACTIVE ELEMENTS === */
document.querySelectorAll('a,button,.coin-card-3d,.pf-card,.opt-item').forEach(el=>{
  el.addEventListener('mouseenter',()=>$('cursorRing').classList.add('hover'));
  el.addEventListener('mouseleave',()=>$('cursorRing').classList.remove('hover'));
});

/* === NAVBAR SCROLL === */
addEventListener('scroll',()=>{$('navbar').classList.toggle('scrolled',scrollY>20);
  const scrollH=document.documentElement.scrollHeight-window.innerHeight;$('scrollProgress').style.width=(scrollY/scrollH*100)+'%';});

/* === INTERSECTION OBSERVER FOR REVEALS === */
const obs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible');});},{threshold:.12});
document.querySelectorAll('.reveal,.reveal-left').forEach(el=>obs.observe(el));

/* === COUNTER ANIMATION === */
function animateCounters(){
  document.querySelectorAll('[data-count]').forEach(el=>{const target=+el.getAttribute('data-count');const duration=2000;const start=performance.now();function tick(now){const p=Math.min((now-start)/duration,1);const e=1-Math.pow(1-p,3);el.textContent=(target*e).toFixed(target>50?0:1);if(p<1)requestAnimationFrame(tick);} requestAnimationFrame(tick);});
}
const cObs=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){animateCounters();cObs.disconnect();}});},{threshold:.3});
document.querySelector('.hero-stats')&&cObs.observe(document.querySelector('.hero-stats'));

/* === BUILDER: MARKETPLACE GRID === */
function renderChains(){
  const q=($('assetSearch').value||'').trim().toLowerCase();
  $('chains').innerHTML=ASSETS.filter(a=>{const m=meta(a);return !q||m.n.toLowerCase().includes(q)||m.s.toLowerCase().includes(q)||a.toLowerCase().includes(q);}).map(a=>{const m=meta(a);return `<div class="coin-card-3d ${sel.has(a)?'selected':''}" data-a="${a}">
    <span class="cc-check">✓</span>
    <div class="cc-top"><div class="cc-sphere" style="--cc:${m.c}">${m.g||m.s}</div><div><div class="cc-name">${m.n}</div><div class="cc-id">${a}</div></div></div>
    <div class="cc-pct"><input type="number" min="0" max="100" step="0.5" value="${sel.has(a)?(sel.get(a)/100).toFixed(2):0}" data-a="${a}"/><span>%</span></div>
  </div>`;}).join('');
  $('chains').querySelectorAll('.coin-card-3d').forEach(card=>{card.addEventListener('click',()=>toggleAsset(card.dataset.a));});
  $('chains').querySelectorAll('.cc-pct input').forEach(inp=>{inp.addEventListener('input',()=>{sel.set(inp.dataset.a,Math.round((+inp.value||0)*100));renderBasket();updateMeter();});});

  // 3D tilt effect on coin cards
  $('chains').querySelectorAll('.coin-card-3d').forEach(card=>{
    card.addEventListener('mousemove',e=>{const r=card.getBoundingClientRect();const x=(e.clientX-r.left-r.width/2)/r.width*.15;const y=(e.clientY-r.top-r.height/2)/r.height*-.15;card.style.transform=`perspective(600px) rotateX(${y}rad) rotateY(${x}rad) translateY(-3px)`;});
    card.addEventListener('mouseleave',()=>{card.style.transform='';});
  });
}
$('assetSearch').addEventListener('input',renderChains);

function toggleAsset(a){if(sel.has(a))sel.delete(a);else sel.set(a,0);renderChains();renderBasket();updateMeter();}

/* === BASKET === */
function renderBasket(){
  const ks=[...sel.keys()];$('basketN').textContent=ks.length+' asset'+(ks.length!==1?'s':'');
  $('basketList').innerHTML=!ks.length?'<div class="basket-empty">Select coins from the marketplace to build your index.</div>':ks.map(a=>{const m=meta(a),pct=(sel.get(a)/100).toFixed(2);return `<div class="br" data-a="${a}"><span style="font-size:13px;width:16px;height:16px;border-radius:50%;background:${m.c};display:inline-block;flex:none"></span><span class="br-sym">${m.s}</span><div class="br-slider"><input type="range" min="0" max="100" step="0.5" value="${pct}" data-a="${a}" style="--val:${m.c};--pct:${pct}%"></div><span class="br-pct">${pct}%</span><button class="br-remove" data-a="${a}">×</button></div>`;}).join('');
  $('basketList').querySelectorAll('.br-slider input').forEach(s=>{s.addEventListener('input',()=>onWeight(s.dataset.a,+s.value,s);});});
  $('basketList').querySelectorAll('.br-remove').forEach(b=>{b.addEventListener('click',()=>toggleAsset(b.dataset.a));});
}

function onWeight(a,v,src){v=Math.max(0,Math.min(100,v||0));sel.set(a,Math.round(v*100));const m=meta(a);const row=$('basketList').querySelector(`.br[data-a="${a}"]`);if(row){const s=row.querySelector('input');const l=row.querySelector('.br-pct');s&&s.style.setProperty('--pct',v+'%');s&&src!==s&&(s.value=v);l&&src!==l&&(l.textContent=v+'%');}updateMeter();}

function updateMeter(){const sum=[...sel.values()].reduce((a,b)=>a+b,0);$('meterFill').style.width=Math.min(sum/100,100)+'%';$('meterFill').className=sum===10000?'ok':sum>10000?'over':'';$('sumLine').className='sum-line'+(sum===10000?'':' bad');$('sumLine').textContent=sum===10000?'✓ Allocated 100%':`${(sum/100).toFixed(2)}% / 100%`;}

/* === DONUT CHART === */
function donut(assets,weights){if(!assets.length)return'<span style="color:var(--mut2);font-family:\'JetBrains Mono\',monospace;font-size:14px;">Select coins to preview your mix.</span>';let acc=0;const segs=assets.map((a,i)=>{const w=weights[i],m=meta(a),s=`${m.c} ${(acc/100).toFixed(2)}% ${((acc+w)/100).toFixed(2)}%`;acc+=w;return s;});const leg=assets.map((a,i)=>{const m=meta(a);return `<div class="leg-r"><span class="leg-dot" style="background:${m.c}"></span><span>${m.s}</span></div>`;}).join('');return `<div class="pie-ring" style="background:conic-gradient(${segs.join(',')})"><div class="pie-hole"><b>${assets.length}</b><span>chains</span></div></div><div class="leg-list">${leg}</div>`;}

/* === PORTFOLIOS === */
const pfKey='xindex.portfolios';
function loadPfs(){try{pfs.length=0;JSON.parse(localStorage.getItem(pfKey)||'[]').forEach(p=>pfs.push(p));}catch(e){}}
function savePfs(){localStorage.setItem(pfKey,JSON.stringify(pfs));}
function addPf(pf){pfs=pfs.filter(p=>p.clone!==pf.clone);pfs.unshift(pf);savePfs();renderPfs();}
function renderPfs(){$('#pf-list').innerHTML=!pfs.length?'<p style="color:var(--mut2);font-family:\'JetBrains Mono\',monospace;text-align:center;padding:40px;">No indexes yet. Create one to get started.</p>':pfs.map((p,i)=>`<div class="pf-card ${activePf&&activePf.clone===p.clone?'active':''}" data-i="${i}"><div class="pf-dots">${p.assets.map(a=>`<span class="pf-dot" style="background:${meta(a).c}"></span>`).join('')}</div><div class="pf-info"><div class="pf-name">${p.name}</div><div class="pf-sub">${p.symbol} · ${p.assets.length} assets · ${short(p.clone)}</div></div></div>`).join('');
  document.querySelectorAll('.pf-card').forEach(row=>{row.addEventListener('click',()=>setActive(pfs[+row.dataset.i]););});}

async function setActive(pf){activePf=pf;const comp=donut(pf.assets,pf.weights);$('#posAlloc').innerHTML=!pf.assets.length?'<span style="color:var(--mut2)">—</span>':comp;$('posShares').textContent='0';$('#composePanel')&&console.log('set active',pf);}

/* === ACTIONS === */
$('createBtn').addEventListener('click',()=>{const ks=[...sel.keys()];if(!ks.length){toast('Select at least one asset','err');return;}if([...sel.values()].reduce((a,b)=>a+b,0)!==10000){toast('Allocations must total exactly 100%','err');return;}
  const pf={clone:'0x'+[...Array(40)].map(()=>Math.random().toString(16)[2]).join(''),name:$('bName').value,symbol:$('bSym').value,assets:ks,weights:ks.map(a=>sel.get(a))};addPf(pf);
  toast(`${pf.name} index created!`,'ok');log(`Created: ${pf.clone}`,'ok');renderPfs();});

$('mintBtn').addEventListener('click',()=>{toast('Investment simulated — check log','ok');log('Invested 1,000 USDT','ok');});
$('burnBtn').addEventListener('click',()=>{toast('Redemption simulated — check log','ok');log('Cashed out shares','ok');});

/* === MODAL === */
function openModal(){$('overlay').classList.add('show');}
function closeModal(){$('overlay').classList.remove('show');}
$('connectBtn').addEventListener('click',openModal);$('heroCta').addEventListener('click',openModal);$('modalX').addEventListener('click',closeModal);
$('overlay').addEventListener('click',e=>{if(e.target===$('overlay'))closeModal();});

$('optDemo').addEventListener('click',()=>{const me='0x'+[...Array(40)].map(()=>Math.random().toString(16)[2]).join('');closeModal();
  $('connectBtn').textContent=short(me);toast('Wallet connected (demo)','ok');log('Connected: '+me,'ok');renderChains();});
$('optMM').addEventListener('click',()=>{toast('MetaMask not available in this environment','err');});

/* === FAUCET === */
$('faucet').addEventListener('click',e=>{e.preventDefault();$('usdtHave').textContent='10,000.00 USDT';toast('10,000 test USDT added','ok');log('Added 10,000 USDT','ok');});

/* === HELPERS === */
function toast(msg,type){const el=document.createElement('div');el.className='toast-item'+(type?' '+type:'');el.textContent=msg;$('toast-box').appendChild(el);setTimeout(()=>el.remove(),4000);}
function log(msg,cls){$('act-log').innerHTML+=`<span style="color:${cls==='ok'?'var(--ok)':cls==='err'?'var(--err)':'var(--mut2)'}">${new Date().toLocaleTimeString()} ${msg}</span>\n`;$('act-log').scrollTop=$('act-log').scrollHeight;}

/* === INIT === */
renderChains();renderBasket();updateMeter();loadPfs();renderPfs();log('System initialized. Connect a wallet to begin.','ok');
</script>
</body>
</html>
